# Dependencias y entornos
node_modules/
dist/
build/
.vite-temp/
__pycache__/
*.py[cod]
*$py.class
*.so
.env
.env.*
!.env.example
venv/
env/
ENV/
.venv/

# Base de datos local y datos en tiempo de ejecución
backend/data/*.db
backend/data/*.sqlite3
backend/data/*.sqlite
*.db-journal
*.db-wal
*.db-shm

# Archivos multimedia subidos (conservar la carpeta con .gitkeep pero ignorar fotos subidas)
backend/uploads/*
!backend/uploads/.gitkeep

# IDEs y editores
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# Logs y temporales
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
